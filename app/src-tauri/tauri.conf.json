{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kingsmint",
  "version": "0.2.0",
  "identifier": "org.kingsmint.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "sh scripts/ui.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/uv",
      "binaries/jj"
    ],
    "resources": {
      "../../template/": "template/",
      "../server/": "server/",
      "../dist/": "dist/"
    }
  }
}
